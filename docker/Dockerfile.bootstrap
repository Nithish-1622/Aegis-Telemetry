# Multi-stage Dockerfile for Aegis Telemetry Bootstrap Application
FROM eclipse-temurin:25-jdk-alpine AS builder
RUN apk add --no-cache maven
WORKDIR /build

# Copy full repository context so Maven parent reactor modules resolve
COPY . .

# Package application
RUN mvn clean package -pl telemetry-bootstrap -am -DskipTests

# Runtime stage
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app

COPY --from=builder /build/telemetry-bootstrap/target/telemetry-bootstrap-0.1.0-SNAPSHOT.jar /app/app.jar

EXPOSE 8085
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
